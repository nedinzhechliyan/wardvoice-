# AWS region to deploy to (Free Tier eligible regions: us-east-1, us-west-2, eu-west-1)
AWS_REGION=us-east-1

# DynamoDB table name (auto-created by deploy script)
DYNAMO_TABLE=wardvoice-issues

# Set automatically by Lambda runtime — do not set manually
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# For local dev only:
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# App URL (set to Lambda Function URL after deployment)
APP_URL=
